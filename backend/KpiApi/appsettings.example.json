{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=kpi_db;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TreatTinyAsBoolean=true;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES",
    "Issuer": "KpiApi",
    "Audience": "KpiClient",
    "ExpireMinutes": 60
  },
  "AllowedCorsOrigins": [
    "http://localhost:3000"
  ]
}